<div class="fu-parser-pdf-form">
    <div class="fu-parser-field">
        <label class="fu-parser-field-label">Book type</label>
        <select name="bookType">{{ selectOptions bookTypes selected=bookType }}</select>
    </div>
    <div class="fu-parser-field">
        <label class="fu-parser-field-label">Source PDF</label>
        <file-picker type="any" name="pdfPath" placeholder="Path to your pdf" value="{{pdfPath}}"></file-picker>
    </div>
    <div class="fu-parser-field">
        <label class="fu-parser-field-label">Image output folder</label>
        <file-picker type="folder" name="imagePath" placeholder="Path to save images" value="{{imagePath}}"></file-picker>
    </div>
    <div class="fu-parser-actions">
        <button type="button" class="fu-parser-import-btn" data-action="import" {{#if disabled}}disabled{{/if}}>
            <i class="fa-solid fa-file-import"></i>
            Import Data
        </button>
    </div>
    <div class="fu-parser-parse-list">
        {{#if (gt parseResults.length 0)}}
        <h2>Preview:</h2>
        {{#each parseResults}}

            {{#if (eq this.type "success") }}
            <div class="fu-parser-parse-success fu-parser-collapsible fu-parser-selectable" data-action="toggleCollapse">
                Page {{this.page}} - OK
            </div>
            <div class="fu-parser-content">
                {{#each this.results}}
                    <div class="fu-parser-selectable">{{this.name}}</div>
                {{/each}}
            </div>
            {{else}}
            <div class="fu-parser-parse-failure fu-parser-collapsible fu-parser-selectable" data-action="toggleCollapse">
                Page {{this.page}} - failure
            </div>
            <div class="fu-parser-content">

                {{#if (eq this.type "too many") }}
                <div class="fu-parser-selectable">Successful parses: {{this.count}}</div>
                {{/if}}
                <h2 class="fu-parser-selectable">Failed parses:</h2>
                <div class="fu-parser-selectable" style="display:grid; grid-template-columns: 15% 12% 70%; grid-gap: 10px 5%">
                    <div class="fu-parser-selectable">Token #</div>
                    <div class="fu-parser-selectable">Looking for</div>
                    <div class="fu-parser-selectable">Found</div>
                    {{#each this.errors}}
                        <div class="fu-parser-selectable">{{this.distance}}</div>
                        <div class="fu-parser-selectable">{{this.error}}</div>
                        <div class="fu-parser-selectable">{{this.found}}</div>
                    {{/each}}
                </div>
            </div>

            {{/if}}
        {{/each}}
        {{/if}}
    </div>
</div>
